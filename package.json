{
  "name": "vocab-forge",
  "version": "2.0.0",
  "description": "Obsidian English Fluency OS with YouTube Smart Capture, FSRS, dictation, shadowing, voice roleplay and local AI CLIs.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "flashcards",
    "spaced-repetition",
    "fsrs",
    "english",
    "vocabulary"
  ],
  "author": "Tony Hoang <tony@tranvanhoang.com>",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "ts-fsrs": "^5.4.1"
  }
}
